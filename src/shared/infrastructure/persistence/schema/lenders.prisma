/// Día de la semana, para los días sin cobro recurrentes de un prestamista.
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// La operación de préstamo: su cartera, cobradores y clientes están aislados de los demás
/// prestamistas, incluso de los del mismo Tenant.
model Lender {
  id                   String    @id @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  name                 String
  logoUrl              String?   @map("logo_url")
  nonWorkingWeekdays   Weekday[] @default([SUNDAY]) @map("non_working_weekdays")
  skipNationalHolidays Boolean   @default(false) @map("skip_national_holidays")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("lenders")
}
