# Variables de entorno de la API. Copia este archivo a `.env` para desarrollo local (nunca se
# commitea). Producción no lo lee: la plataforma inyecta las variables. Detalle: ARCHITECTURE.md §9.

# development | test | production
NODE_ENV=development

# Puerto HTTP
PORT=3000

# Orígenes con acceso desde un navegador, separados por coma y sin barra final. Vacío: ninguno.
# Ejemplo: CORS_ORIGINS=http://localhost:3001
CORS_ORIGINS=

# Proxies de confianza delante de la API (0 a 10); de ahí sale la IP que cuenta el rate limit.
# 1 = detrás de Fly.io, 0 = conexión directa. Obligatoria en producción (va también en `fly.toml`).
TRUST_PROXY=1

# Rate limit por IP y por ruta: ventana en milisegundos y máximo de peticiones dentro de ella.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Documentación en /docs. Por defecto: activa salvo en producción.
SWAGGER_ENABLED=true

# Nivel mínimo de los logs (JSON en la salida estándar): fatal, error, warn, info, debug, trace o
# silent. Por defecto: info (silent en las pruebas).
LOG_LEVEL=info

# PostgreSQL. Este valor es el de `pnpm docker:infra`; con `pnpm docker:dev` la API ya recibe el suyo.
DATABASE_URL=postgresql://fiaro:fiaro@localhost:5440/fiaro

# Registro durable: Redis (la cola de BullMQ) y MongoDB (donde se guardan los eventos de auditoría
# y las líneas de log, con el nombre de la base de datos en la URI). Estos valores son los de
# `pnpm docker:infra`. Sin ellas, lo que se registra solo sale por el log; obligatorias en producción.
REDIS_URL=redis://127.0.0.1:6390
MONGODB_URI=mongodb://fiaro:fiaro@127.0.0.1:27040/fiaro?authSource=admin

# Prefijo de las llaves de las colas en Redis: separa entornos que comparten una instancia.
QUEUE_PREFIX=fiaro

# Firma las cookies de sesión (mínimo 32 caracteres). Este es solo para desarrollo: en producción
# genera uno propio con `openssl rand -base64 32` y guárdalo en los secretos de la plataforma.
BETTER_AUTH_SECRET=secreto-solo-para-desarrollo-de-fiaro-2026

# Origen (esquema, host y puerto, sin ruta) desde el que las apps llegan a la API.
BETTER_AUTH_URL=http://localhost:3000

# Esquemas de enlace profundo de las apps nativas (el `scheme` de su app.json), separados por
# coma. Sin ellos, la app móvil recibe 403 en las peticiones con sesión. Vacío: ninguno.
MOBILE_APP_SCHEMES=mobile

# Envío de correos con Resend (https://resend.com). Sin ellas, en desarrollo el correo solo se
# escribe en el log en vez de enviarse; obligatorias en producción.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Fiaro <no-reply@tu-dominio-verificado.com>

# Version-gate de la app móvil (GET /mobile/version, PRODUCT.md §10): versión mínima que la app
# acepta sin bloquear, versión más reciente publicada y de dónde descargar el APK. Formato
# MAYOR.MENOR.PARCHE. Sin ellas, en desarrollo se usan valores que nunca bloquean a nadie;
# obligatorias en producción.
# MOBILE_MIN_SUPPORTED_VERSION=1.0.0
# MOBILE_LATEST_VERSION=1.0.0
# MOBILE_DOWNLOAD_URL=https://tu-dominio.com/fiaro.apk

# Si está en `true`, GET /health responde 503 MAINTENANCE (y nada más): para que el orquestador
# saque la instancia de circulación durante una ventana de mantenimiento. Por defecto: false.
MAINTENANCE_MODE=false

# Notificaciones push (D-95). PUSH_DELIVERY=expo manda a Expo (https://expo.dev), que entrega a
# Android y a iOS; PUSH_DELIVERY=log solo las escribe en el log. Por defecto: expo en producción,
# log en el resto. EXPO_ACCESS_TOKEN solo hace falta si la cuenta de Expo tiene activada la
# seguridad mejorada de las notificaciones push.
# PUSH_DELIVERY=log
# EXPO_ACCESS_TOKEN=...

# Aviso diario de mora (D-96): a las 08:00 de Bogotá, a quien administra cada prestamista que tiene
# préstamos en mora. Por defecto: activo, salvo en las pruebas.
# MORA_ALERTS=true
