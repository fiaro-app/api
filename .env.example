# Variables de entorno de la API. Copia este archivo a `.env` para desarrollo local (nunca se
# commitea). Producción no lo lee: la plataforma inyecta las variables. Detalle: ARCHITECTURE.md §9.

# development | test | production
NODE_ENV=development

# Puerto HTTP
PORT=3000

# Orígenes con acceso desde un navegador, separados por coma y sin barra final. Vacío: ninguno.
# Ejemplo: CORS_ORIGINS=http://localhost:3001
CORS_ORIGINS=

# Proxies de confianza delante de la API (0 a 10); de ahí sale la IP que cuenta el rate limit.
# 1 = detrás de Fly.io, 0 = conexión directa. Obligatoria en producción (va también en `fly.toml`).
TRUST_PROXY=1

# Rate limit por IP y por ruta: ventana en milisegundos y máximo de peticiones dentro de ella.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Documentación en /docs. Por defecto: activa salvo en producción.
SWAGGER_ENABLED=true

# Nivel mínimo de los logs (JSON en la salida estándar): fatal, error, warn, info, debug, trace o
# silent. Por defecto: info (silent en las pruebas).
LOG_LEVEL=info

# PostgreSQL. Este valor es el de `pnpm docker:infra`; con `pnpm docker:dev` la API ya recibe el suyo.
DATABASE_URL=postgresql://fiaro:fiaro@localhost:5440/fiaro

# Firma las cookies de sesión (mínimo 32 caracteres). Este es solo para desarrollo: en producción
# genera uno propio con `openssl rand -base64 32` y guárdalo en los secretos de la plataforma.
BETTER_AUTH_SECRET=secreto-solo-para-desarrollo-de-fiaro-2026

# Origen (esquema, host y puerto, sin ruta) desde el que las apps llegan a la API.
BETTER_AUTH_URL=http://localhost:3000

# Esquemas de enlace profundo de las apps nativas (el `scheme` de su app.json), separados por
# coma. Sin ellos, la app móvil recibe 403 en las peticiones con sesión. Vacío: ninguno.
MOBILE_APP_SCHEMES=mobile
