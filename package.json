{
  "name": "api",
  "version": "0.0.1",
  "description": "API de Fiaro — backend NestJS del sistema de control de cartera (gota a gota) para prestamistas informales.",
  "author": "Alejo Zuleta <jhoitan266@gmail.com>",
  "private": true,
  "license": "UNLICENSED",
  "homepage": "https://github.com/fiaro-app/api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fiaro-app/api.git"
  },
  "bugs": {
    "url": "https://github.com/fiaro-app/api/issues"
  },
  "keywords": [
    "fiaro",
    "nestjs",
    "api",
    "prestamos",
    "fintech",
    "cartera"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky && prisma generate",
    "build": "prisma generate && nest build",
    "format": "prettier --write . --cache --cache-location node_modules/.cache/prettier/.prettier-cache",
    "format:check": "prettier --check . --cache --cache-location node_modules/.cache/prettier/.prettier-cache",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --enable-source-maps dist/main",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --project unit --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --project e2e",
    "docs": "compodoc -p tsconfig.json -d docs --disableGraph --disableCoverage --disablePrivate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node scripts/seed-dev-users.js",
    "docker:infra": "docker compose up -d --wait postgres redis mongo s3 mailpit",
    "docker:dev": "NODE_AUTH_TOKEN=\"${NODE_AUTH_TOKEN:-$(gh auth token)}\" docker compose up -d --build --wait",
    "docker:dev:obs": "NODE_AUTH_TOKEN=\"${NODE_AUTH_TOKEN:-$(gh auth token)}\" docker compose --profile observability up -d --build --wait",
    "docker:test": "NODE_AUTH_TOKEN=\"${NODE_AUTH_TOKEN:-$(gh auth token)}\" docker compose -p fiaro-test -f compose.yaml -f compose.test.yaml run --rm --build test; s=$?; docker compose -p fiaro-test -f compose.yaml -f compose.test.yaml down; exit $s",
    "docker:seed": "docker compose exec api node scripts/seed-dev-users.js",
    "docker:down": "docker compose --profile observability down",
    "docker:reset": "docker compose --profile observability down --volumes"
  },
  "dependencies": {
    "@better-auth/expo": "~1.7.5",
    "@better-auth/prisma-adapter": "~1.7.5",
    "@fiaro-app/contracts": "^0.1.0",
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "better-auth": "~1.7.5",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.4",
    "@nestjs/testing": "^12.0.4",
    "@standard-schema/spec": "^1.1.0",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-tsdoc": "^0.5.3",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prisma": "~7.10.0",
    "supertest": "^7.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24"
  }
}
