{
  "name": "api",
  "version": "0.0.1",
  "description": "API de Fiaro — backend NestJS del sistema de control de cartera (gota a gota) para prestamistas informales.",
  "author": "Alejo Zuleta <jhoitan266@gmail.com>",
  "private": true,
  "license": "UNLICENSED",
  "homepage": "https://github.com/fiaro-app/api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fiaro-app/api.git"
  },
  "bugs": {
    "url": "https://github.com/fiaro-app/api/issues"
  },
  "keywords": [
    "fiaro",
    "nestjs",
    "api",
    "prestamos",
    "fintech",
    "cartera"
  ],
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write . --cache --cache-location node_modules/.cache/prettier/.prettier-cache",
    "format:check": "prettier --check . --cache --cache-location node_modules/.cache/prettier/.prettier-cache",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --enable-source-maps dist/main",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "docs": "compodoc -p tsconfig.json -d docs --disableGraph --disableCoverage --disablePrivate"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.4",
    "@nestjs/testing": "^12.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24"
  }
}
